# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit it.

# PostgreSQL connection. Either set a full DATABASE_URL (it wins), or the
# POSTGRES_* parts below, which the server escapes, so any password works.
# DATABASE_URL=postgres://user:password@host:5432/dbname
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=notes_app

# HTTP server port
SERVER_PORT=8080

# "development" (default), "staging" or "production". Swagger UI (/swagger/*) is
# served only in "development", which is also the only place cookies are sent
# over plain http.
APP_ENV=development

# Browser origins allowed to call the API cross-origin with the session cookie,
# comma separated (e.g. https://app.example.com). Leave empty when the frontend
# reaches the API through a proxy under its own domain: the Vite dev server,
# the Docker nginx and the Vercel rewrite all do. "*" is refused.
ALLOWED_ORIGINS=

# How long a login session lasts, as Go durations: it ends after the idle time
# without use, or the absolute time after login, whichever comes first.
SESSION_IDLE_TTL=168h
SESSION_ABSOLUTE_TTL=720h

# Signup email verification (syntax/MX/disposable/SMTP checks, no API key
# needed). Set to "true" to skip it entirely (verification fails open either
# way if a check errors or times out).
DISABLE_EMAIL_VERIFICATION=false

# How long trashed items are kept before they are purged permanently. A Go
# duration (e.g. 720h = 30 days, 30s for testing). Defaults to 720h.
TRASH_RETENTION=720h

# Dev user created by `make seed-user` (also run by `make setup` and `make db-reset`)
# after the database is (re)created. Fill these in your own .env; leave any empty
# to skip. Never used when APP_ENV=production.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
