# Copy this file to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit it.

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=notes_app

# HTTP server port
SERVER_PORT=8080

# "development" (default) or "production". Swagger UI (/swagger/*) is only
# served when this is not "production".
APP_ENV=development

# JWT signing secret — generate a real one with:  openssl rand -base64 48
JWT_SECRET=

# Signup email verification (syntax/MX/disposable/SMTP checks, no API key
# needed). Set to "true" to skip it entirely (verification fails open either
# way if a check errors or times out).
DISABLE_EMAIL_VERIFICATION=false
